-- Utility Core
local function slug(value)
    local id = string.lower(tostring(value or 'control')):gsub('[^%w]+', '_'):gsub('^_+', ''):gsub('_+$', '')
    return id ~= '' and id or 'control'
end

local function option(options, lower, upper, fallback)
    if options[lower] ~= nil then return options[lower] end
    if options[upper] ~= nil then return options[upper] end
    return fallback
end

-- Cleanup manager
local Cleanup = {}
Cleanup.__index = Cleanup
function Cleanup.new()
    return setmetatable({tasks = {}, destroyed = false}, Cleanup)
end
function Cleanup:Add(dispose)
    if self.destroyed then dispose() else table.insert(self.tasks, dispose) end
    return dispose
end
function Cleanup:Destroy()
    if self.destroyed then return end
    self.destroyed = true
    for i = #self.tasks, 1, -1 do pcall(self.tasks[i]) end
    table.clear(self.tasks)
end

-- Store & Validation
local Store = {}
Store.__index = Store
function Store.new()
    return setmetatable({entries = {}, destroyed = false}, Store)
end
function Store:Register(id, default, normalize, metadata)
    self.entries[id] = {value = normalize(default), normalize = normalize, metadata = metadata, listeners = {}}
end
function Store:Get(id) return self.entries[id].value end
function Store:Set(id, value)
    local entry = self.entries[id]
    local norm = entry.normalize(value)
    if entry.value == norm then return false end
    entry.value = norm
    for _, l in ipairs(entry.listeners) do task.spawn(l.callback, norm) end
    return true
end
function Store:Subscribe(id, cb)
    local listener = {callback = cb, active = true}
    table.insert(self.entries[id].listeners, listener)
    return function()
        listener.active = false
    end
end
function Store:Snapshot()
    local t = {}
    for k, v in pairs(self.entries) do t[k] = v.value end
    return t
end
function Store:Destroy() self.destroyed = true; table.clear(self.entries) end

-- Theme Manager
local ThemeManager = {}
ThemeManager.__index = ThemeManager
function ThemeManager.new()
    return setmetatable({colors = table.clone(ThemePresets.Blossom), listeners = {}}, ThemeManager)
end
function ThemeManager:Get(token) return self.colors[token] end
function ThemeManager:Subscribe(scope, cb)
    self.listeners[cb] = true
    scope:Add(function() self.listeners[cb] = nil end)
    cb()
end
function ThemeManager:Set(overrides)
    for k, v in pairs(overrides) do self.colors[k] = v end
    for cb in pairs(self.listeners) do cb() end
end
function ThemeManager:Destroy() table.clear(self.listeners) end

-- Renderer
local Renderer = {}
Renderer.__index = Renderer
function Renderer.new(theme, cleanup, reducedMotion)
    return setmetatable({Theme = theme, Scope = cleanup, ReducedMotion = reducedMotion}, Renderer)
end
function Renderer:Connect(signal, cb)
    local conn = signal:Connect(cb)
    self.Scope:Add(function() conn:Disconnect() end)
    return conn
end
function Renderer:Create(className, props, parent, colors)
    local inst = Instance.new(className)
    if inst:IsA('GuiObject') then inst.BorderSizePixel = 0 end
    if inst:IsA('TextLabel') or inst:IsA('TextButton') or inst:IsA('TextBox') then
        inst.Font = Enum.Font.Gotham
        inst.TextSize = Tokens.TextSize
    end
    if inst:IsA('GuiButton') then inst.AutoButtonColor = false end
    for k, v in pairs(props) do inst[k] = v end
    for prop, token in pairs(colors or {}) do
        self.Theme:Subscribe(self.Scope, function() inst[prop] = self.Theme:Get(token) end)
    end
    inst.Parent = parent
    return inst
end
function Renderer:Corner(parent, radius)
    return self:Create('UICorner', {CornerRadius = UDim.new(0, radius or Tokens.ControlRadius)}, parent)
end
function Renderer:Stroke(parent, token)
    return self:Create('UIStroke', {Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, parent, {Color = self.Theme:Get(token or 'Outline')})
end
function Renderer:Label(parent, text, props, token)
    local p = {Name = 'Label', Text = text, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, Tokens.RowHeight), TextXAlignment = Enum.TextXAlignment.Left}
    for k, v in pairs(props or {}) do p[k] = v end
    return self:Create('TextLabel', p, parent, {TextColor3 = token or 'Text'})
end
function Renderer:List(parent, gap)
    return self:Create('UIListLayout', {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, gap or Tokens.ControlGap)}, parent)
end
function Renderer:Padding(parent, pad)
    return self:Create('UIPadding', {PaddingLeft = UDim.new(0, pad), PaddingRight = UDim.new(0, pad), PaddingTop = UDim.new(0, pad), PaddingBottom = UDim.new(0, pad)}, parent)
end
function Renderer:Feedback(button, isDisabled)
    local hovered, pressed = false, false
    local function paint()
        local dis = isDisabled and isDisabled()
        local token = dis and 'Element' or (pressed and 'Element' or (hovered and 'HoveredElement' or 'Input'))
        button.BackgroundColor3 = self.Theme:Get(token)
    end
    self:Connect(button.MouseEnter, function() hovered = true; paint() end)
    self:Connect(button.MouseLeave, function() hovered = false; pressed = false; paint() end)
    self:Connect(button.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then pressed = true; paint() end end)
    self:Connect(button.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then pressed = false; paint() end end)
    self.Theme:Subscribe(self.Scope, paint)
    return paint
end

-- Core Input & Overlay
local InputManager = {}
function InputManager.new(renderer)
    local active = nil
    renderer:Connect(UserInputService.InputChanged, function(input)
        if active and input == active.input then active.move(Vector2.new(input.Position.X, input.Position.Y)) end
    end)
    renderer:Connect(UserInputService.InputEnded, function(input)
        if active and input == active.input then active = nil end
    end)
    return {Begin = function(_, input, move, finish) active = {input = input, move = move, finish = finish}; move(Vector2.new(input.Position.X, input.Position.Y)) return true end, Cancel = function() active = nil end}
end

local OverlayManager = {}
function OverlayManager.new(context, layer)
    return {Close = function() if layer:FindFirstChild('Popup') then layer.Popup:Destroy() end end, IsOpen = function() return false end, Open = function(_, owner, anchor, height)
        local frame = context.Renderer:Create('ScrollingFrame', {Name = 'Popup', Size = UDim2.fromOffset(anchor.AbsoluteSize.X, height), Position = UDim2.fromOffset(anchor.AbsolutePosition.X, anchor.AbsolutePosition.Y + anchor.AbsoluteSize.Y), ZIndex = 50, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, layer, {BackgroundColor3 = 'Background'})
        context.Renderer:Corner(frame)
        context.Renderer:Stroke(frame)
        context.Renderer:List(frame, 1)
        return frame, context.Renderer
    end}
end

-- Window & Framework Construction
function Blossom.new(options)
    options = options or {}
    local cleanup = Cleanup.new()
    local store = Store.new()
    local theme = ThemeManager.new()
    local renderer = Renderer.new(theme, cleanup, false)
    local input = InputManager.new(renderer)

    local gui = renderer:Create('ScreenGui', {Name = 'BlossomGui', ResetOnSpawn = false, Parent = Players.LocalPlayer:WaitForChild('PlayerGui')}, nil)
    local root = renderer:Create('Frame', {Name = 'Window', Size = UDim2.fromOffset(422, 336), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Active = true}, gui, {BackgroundColor3 = 'Background'})
    renderer:Corner(root, Tokens.Radius)
    renderer:Stroke(root)

    local sidebar = renderer:Create('Frame', {Name = 'Sidebar', Size = UDim2.new(0, Tokens.Sidebar, 1, 0)}, root, {BackgroundColor3 = 'Sidebar'})
    renderer:Corner(sidebar, Tokens.Radius)
    local nav = renderer:Create('ScrollingFrame', {Name = 'Nav', Position = UDim2.fromOffset(7, 40), Size = UDim2.new(1, -14, 1, -50), BackgroundTransparency = 1, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, sidebar)
    renderer:List(nav, 3)

    local content = renderer:Create('Frame', {Name = 'Content', Position = UDim2.fromOffset(Tokens.Sidebar + 8, 8), Size = UDim2.new(1, -Tokens.Sidebar - 16, 1, -16), BackgroundTransparency = 1}, root)
    local overlayLayer = renderer:Create('Frame', {Name = 'Overlay', Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 40}, root)

    local context = {Cleanup = cleanup, Store = store, Theme = theme, Renderer = renderer, Input = input, Root = root, Content = content, OverlayLayer = overlayLayer, Pages = {}, Registry = {} }
    context.Overlay = OverlayManager.new(context, overlayLayer)

    local self = setmetatable({_context = context, Pages = {}}, Blossom)
    context.Library = self
    return self
end

function Blossom:CreateWindow(options)
    return self.new(options)
end

function Blossom:AddPage(options)
    local r = self._context.Renderer
    local pageFrame = r:Create('Frame', {Name = 'Page_' .. options.Name, Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = #self.Pages == 0}, self._context.Content)
    local col = r:Create('ScrollingFrame', {Name = 'Col1', Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, pageFrame)
    r:List(col, 8)

    local page = {Frame = pageFrame, Body = col, Sections = {}}
    table.insert(self.Pages, page)

    return {
        AddSection = function(_, secOpts)
            local secFrame = r:Create('Frame', {Name = 'Section', Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y}, col, {BackgroundColor3 = 'Tab'})
            r:Corner(secFrame, Tokens.CardRadius)
            r:List(secFrame, 3)
            r:Padding(secFrame, 7)
            r:Label(secFrame, secOpts.Name, {Font = Enum.Font.GothamMedium}, 'Accent')
            
            return {
                CreateButton = function(_, btnOpts)
                    local btn = r:Create('TextButton', {Name = 'Button', Text = btnOpts.Name, Size = UDim2.new(1, 0, 0, Tokens.FieldHeight)}, secFrame, {TextColor3 = 'Text'})
                    r:Corner(btn, Tokens.ControlRadius)
                    r:Stroke(btn)
                    r:Feedback(btn)
                    r:Connect(btn.Activated, function() pcall(btnOpts.Callback) end)
                end,
                CreateToggle = function(_, togOpts)
                    local toggled = togOpts.Default or false
                    local btn = r:Create('TextButton', {Name = 'Toggle', Text = togOpts.Name .. ': ' .. tostring(toggled), Size = UDim2.new(1, 0, 0, Tokens.FieldHeight)}, secFrame, {TextColor3 = 'Text'})
                    r:Corner(btn, Tokens.ControlRadius)
                    r:Stroke(btn)
                    r:Feedback(btn)
                    r:Connect(btn.Activated, function()
                        toggled = not toggled
                        btn.Text = togOpts.Name .. ': ' .. tostring(toggled)
                        pcall(togOpts.Callback, toggled)
                    end)
                end,
                CreateSlider = function(_, slidOpts)
                    local val = slidOpts.Default or slidOpts.Range[1]
                    local btn = r:Create('TextButton', {Name = 'Slider', Text = slidOpts.Name .. ': ' .. tostring(val) .. (slidOpts.Suffix or ''), Size = UDim2.new(1, 0, 0, Tokens.FieldHeight)}, secFrame, {TextColor3 = 'Text'})
                    r:Corner(btn, Tokens.ControlRadius)
                    r:Stroke(btn)
                    r:Feedback(btn)
                    r:Connect(btn.Activated, function()
                        val = val + (slidOpts.Increment or 1)
                        if val > slidOpts.Range[2] then val = slidOpts.Range[1] end
                        btn.Text = slidOpts.Name .. ': ' .. tostring(val) .. (slidOpts.Suffix or '')
                        pcall(slidOpts.Callback, val)
                    end)
                end,
                CreateDropdown = function(_, dropOpts)
                    local current = dropOpts.Default or dropOpts.Options[1]
                    local idx = 1
                    local btn = r:Create('TextButton', {Name = 'Dropdown', Text = dropOpts.Name .. ': ' .. tostring(current), Size = UDim2.new(1, 0, 0, Tokens.FieldHeight)}, secFrame, {TextColor3 = 'Text'})
                    r:Corner(btn, Tokens.ControlRadius)
                    r:Stroke(btn)
                    r:Feedback(btn)
                    r:Connect(btn.Activated, function()
                        idx = idx % #dropOpts.Options + 1
                        current = dropOpts.Options[idx]
                        btn.Text = dropOpts.Name .. ': ' .. tostring(current)
                        pcall(dropOpts.Callback, current)
                    end)
                end,
                CreateTextInput = function(_, inOpts)
                    local box = r:Create('TextBox', {Name = 'Input', PlaceholderText = inOpts.Placeholder or '', Text = '', Size = UDim2.new(1, 0, 0, Tokens.FieldHeight)}, secFrame, {BackgroundColor3 = 'Input', TextColor3 = 'Text'})
                    r:Corner(box, Tokens.ControlRadius)
                    r:Stroke(box)
                    r:Connect(box.FocusLost, function(enter)
                        if enter then pcall(inOpts.Callback, box.Text) end
                    end)
                end,
                CreateKeybind = function(_, kbOpts)
                    local key = kbOpts.Default or Enum.KeyCode.RightControl
                    local btn = r:Create('TextButton', {Name = 'Keybind', Text = kbOpts.Name .. ' [ ' .. tostring(key.Name) .. ' ]', Size = UDim2.new(1, 0, 0, Tokens.FieldHeight)}, secFrame, {TextColor3 = 'Text'})
                    r:Corner(btn, Tokens.ControlRadius)
                    r:Stroke(btn)
                    r:Feedback(btn)
                end,
                CreateColorPicker = function(_, cpOpts)
                    local btn = r:Create('TextButton', {Name = 'ColorPicker', Text = cpOpts.Name, Size = UDim2.new(1, 0, 0, Tokens.FieldHeight)}, secFrame, {TextColor3 = 'Text'})
                    r:Corner(btn, Tokens.ControlRadius)
                    r:Stroke(btn)
                    r:Feedback(btn)
                    r:Connect(btn.Activated, function() pcall(cpOpts.Callback, cpOpts.Default) end)
                end
            }
        end
    }
end

function Blossom:CreateTab(options)
    return self:AddPage(options)
end

return Blossom
